# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite Local Database (Development)
DATABASE_FILE=dev.db

# Dev Auth Mode (set to false when testing real Firebase Authentication)
DEV_AUTH_BYPASS=true

# Firebase Authentication (Client Web SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin (Server Session Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Centralized Gmail Connector (OAuth 2.0 Web Application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Security & Encryption (AES-256-GCM for storing Gmail refresh tokens)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
